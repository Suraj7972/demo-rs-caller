# Dashboard env (copy to .env.local). Only NEXT_PUBLIC_* vars reach the browser.
# Same values as SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY in the root .env
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Our FastAPI base URL (PUBLIC_BASE_URL in prod, http://localhost:8000 in dev)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
