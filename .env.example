# =============================================================================
# PropCall environment. Copy to `.env` and fill in. Never commit `.env`.
# Loaded by packages/shared/config.py (pydantic-settings) and docker compose.
# =============================================================================

# ----------------------------------------------------------------- App -------
# dev | staging | prod
APP_ENV=dev
# Python log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Public HTTPS origin where Plivo/Meta reach us (answer URLs, webhooks, wss stream).
# In dev use an ngrok/cloudflared tunnel, e.g. https://abc123.ngrok-free.app
PUBLIC_BASE_URL=https://propcall.example.com
# IANA timezone used for calling windows and scheduling
TIMEZONE=Asia/Kolkata
# Where pre-generated TTS clips live (per org/project/language)
AUDIO_CACHE_DIR=audio_cache
# Long random string; encrypts short-lived tokens (e.g. transfer targets in Plivo callback URLs).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# ----------------------------------------------------------- Caddy / TLS -----
# Hostname Caddy serves and gets a Let's Encrypt cert for (DNS A record -> VPS)
DOMAIN=propcall.example.com
# Email for Let's Encrypt expiry notices
ACME_EMAIL=ops@example.com

# ------------------------------------------------------------ Telephony ------
# Active TelephonyProvider implementation: plivo | exotel
TELEPHONY_PROVIDER=plivo
# Plivo console -> API keys. Auth token also verifies webhook signatures (V3).
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# Plivo number (E.164) used as caller ID for outbound calls, e.g. +9122XXXXXXXX
PLIVO_CALLER_ID=
# Verify X-Plivo-Signature-V3 on every Plivo webhook. Keep true; false only for local curl testing.
PLIVO_VERIFY_SIGNATURES=true
# Exotel (future provider; leave blank until used)
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
# Exotel API host for your account's region, e.g. api.exotel.com / api.in.exotel.com
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=

# --------------------------------------------------------------- Sarvam ------
# Sarvam AI API key (STT, TTS, and live LLM when LLM_LIVE_PROVIDER=sarvam)
SARVAM_API_KEY=
# Streaming STT model (code-mixed Indian speech). Pipecat 1.11 default: saaras:v4
SARVAM_STT_MODEL=saaras:v4
# Bulbul TTS model. bulbul:v2 is deprecated by Sarvam.
SARVAM_TTS_MODEL=bulbul:v3
# Bulbul voice / speaker id (must be valid for the chosen model)
SARVAM_TTS_SPEAKER=shubh

# -------------------------------------------------------- LLM (live call) ----
# Provider behind LLMProvider for in-call turns: sarvam | openai | anthropic
LLM_LIVE_PROVIDER=sarvam
# Fast, cheap model id for that provider. sarvam-105b-conversations is Sarvam's
# non-reasoning chat model (lower latency than sarvam-105b, which reasons).
LLM_LIVE_MODEL=sarvam-105b-conversations

# -------------------------------------------------------- LLM (post-call) ----
# Provider for summary / scoring / extraction: anthropic | openai | sarvam
LLM_POSTCALL_PROVIDER=anthropic
# Stronger model id for that provider
LLM_POSTCALL_MODEL=claude-sonnet-5
# Only the key(s) for providers you actually use are required
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------------------------- Supabase ------
# Project URL, e.g. https://xyzcompany.supabase.co
SUPABASE_URL=
# Publishable (formerly "anon") key - safe for browser, subject to RLS
SUPABASE_PUBLISHABLE_KEY=
# Secret (formerly "service_role") key - server only, BYPASSES RLS
SUPABASE_SECRET_KEY=
# JWT secret, only if verifying legacy HS256 user JWTs in the API (JWKS otherwise)
SUPABASE_JWT_SECRET=
# Direct Postgres URL used by `make migrate` (Settings -> Database -> Connection string)
SUPABASE_DB_URL=postgresql://postgres:password@db.xyzcompany.supabase.co:5432/postgres
# Storage bucket for call recordings (private)
SUPABASE_BUCKET_RECORDINGS=recordings
# Storage bucket for brochures / floor plans sent on WhatsApp
SUPABASE_BUCKET_MEDIA=project-media

# ------------------------------------------------ Meta WhatsApp Cloud API ----
# System-user permanent access token with whatsapp_business_messaging scope
WHATSAPP_ACCESS_TOKEN=
# Phone number ID (not the phone number) from WhatsApp Manager -> API setup
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp Business Account ID (templates are managed per WABA)
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Any random string; must match what you enter when registering the webhook in Meta
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta app secret - verifies X-Hub-Signature-256 on WhatsApp and Lead Ads webhooks
META_APP_SECRET=
# Graph API version for all Meta calls - check Meta's changelog for the latest
META_GRAPH_API_VERSION=v23.0

# --------------------------------------------------------- Lead sources ------
# Page access token (leads_retrieval) to fetch Meta Lead Ads form submissions
META_LEADS_PAGE_ACCESS_TOKEN=
# Shared key configured in the Google Ads lead-form webhook (sent as `google_key`)
GOOGLE_ADS_WEBHOOK_KEY=
# HMAC secret for our generic website / portal lead webhook
WEBSITE_LEAD_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Redis ------
# arq job queue + dialer state. In docker compose use redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------ Call policy defaults -------
# Global calling window (IST). Campaigns may only narrow it.
CALLING_WINDOW_START=09:00
CALLING_WINDOW_END=21:00
# Hard max call length in seconds (6 min)
MAX_CALL_DURATION_S=360
# Hang up after this many seconds with no caller speech
SILENCE_TIMEOUT_S=10
# Default concurrent calls per campaign
DEFAULT_MAX_CONCURRENCY=2

# ---------------------------------------------------------------- Ports ------
# FastAPI REST + webhooks
API_PORT=8000
# Pipecat voice websocket server
VOICE_PORT=8765
